{
  "name": "cell-to-singularity-tools",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "description": "Cell to Singularity 探索活动规划助手：多资源、多工厂、多升级与到点提醒",
  "keywords": [
    "cell-to-singularity",
    "exploration",
    "planner"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench": "vite-node bench/planner-bench.ts",
    "lint": "eslint .",
    "verify": "node scripts/verify-dist.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vite-node": "^3.2.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  }
}
